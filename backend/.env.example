# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas free tier, or local mongodb://localhost:27017/complaint-system)
MONGO_URI=mongodb://localhost:27017/complaint-system

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# OpenAI (used for categorization, priority, sentiment, summary, duplicate detection)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Email (optional - for status update notifications). Leave blank to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@complaintsystem.com

# Admin escalation threshold in hours - complaints unresolved past this get auto-escalated
ESCALATION_HOURS=48
