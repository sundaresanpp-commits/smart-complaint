# Server
PORT=5000
NODE_ENV=development

# MongoDB (use MongoDB Atlas free tier, or local mongodb://localhost:27017/complaint-system)
MONGO_URI=mongodb+srv://sundaresanpp_db_user:I8HzYlv7hxK4YIIW@cluster0.ydrxfur.mongodb.net/?appName=Cluster0

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# OpenAI (used for categorization, priority, sentiment, summary, duplicate detection)
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# SMTP (required for login/register OTP emails and optional status notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# For Resend testing use: CampusFix <onboarding@resend.dev>
# For production, replace this with an address on a domain verified in Resend.
EMAIL_FROM=CampusFix <onboarding@resend.dev>

# Optional secret mixed into the stored OTP hash. Use a long random value in production.
OTP_SECRET=change_this_to_a_long_random_string

# Admin escalation threshold in hours - complaints unresolved past this get auto-escalated
ESCALATION_HOURS=48

# Maximum distance between similar complaints for duplicate matching
DUPLICATE_DISTANCE_METERS=100


# Resolved complaints disappear from All Complaints after this many days, then are deleted after the retention period
RESOLVED_COMPLAINT_VISIBILITY_DAYS=15
RESOLVED_COMPLAINT_RETENTION_DAYS=30
